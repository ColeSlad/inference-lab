# mock | openai | transformers
INFERENCE_LAB_BACKEND=mock
INFERENCE_LAB_MODEL=Qwen/Qwen3-0.6B

# Used by the OpenAI-compatible adapter (for vLLM, TGI-compatible proxies, etc.)
INFERENCE_LAB_UPSTREAM_URL=http://localhost:8001
INFERENCE_LAB_UPSTREAM_API_KEY=not-needed
INFERENCE_LAB_REQUEST_TIMEOUT_S=180

# Deterministic local development backend
INFERENCE_LAB_MOCK_FIRST_TOKEN_MS=40
INFERENCE_LAB_MOCK_TOKEN_MS=8

# Hugging Face local baseline
INFERENCE_LAB_TRANSFORMERS_DEVICE=auto
INFERENCE_LAB_TRANSFORMERS_DTYPE=auto
